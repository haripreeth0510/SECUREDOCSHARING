# Copy to .env and fill in. .env is gitignored; never commit real values.
APP_PORT=8080
APP_ENV=development            # development | test | staging | production (non-local envs set Secure cookies)

DB_HOST=localhost
DB_PORT=5432
DB_USER=securedoc
DB_PASSWORD=change-me
DB_NAME=securedocsharing
DB_SSLMODE=disable             # use require/verify-full outside local development
DATABASE_URL=postgres://securedoc:change-me@localhost:5432/securedocsharing?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Auth. Generate the secret with: openssl rand -base64 48   (minimum 32 bytes)
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
TERMS_VERSION=1.0

# Blob storage: EITHER the Azure account name (keyless, uses Managed Identity / az login)
# AZURE_STORAGE_ACCOUNT=
# OR, for local development only, the Azurite emulator (docker compose up -d azurite):
AZURITE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
AZURE_STORAGE_CONTAINER=documents

# Key management: EITHER Azure Key Vault
# AZURE_KEYVAULT_URL=https://<vault-name>.vault.azure.net/
# AZURE_KEK_NAME=document-kek
# OR, for local development only, a local key (generate with: openssl rand -base64 32)
LOCAL_KEK=
